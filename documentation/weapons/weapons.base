filters:
  and:
    - type == "weapon"
    - '!file.inFolder("_templates")'
views:
  - type: table
    name: All weapons
    order:
      - file.name
      - status
      - element
      - damage
      - projectileSpeed
      - projectileDistance
      - projectiles
      - knockBack
      - fireCooldown
      - clipSize
      - debuff
